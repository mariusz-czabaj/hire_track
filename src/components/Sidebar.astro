---
const { operations } = Astro.locals;
const pathname = Astro.url.pathname;
const isAdmin = operations.includes("group.manage");

const navItems = [
  { label: "Recruitments", href: "/recruitments" },
  { label: "Candidates", href: "/candidates" },
  ...(isAdmin ? [{ label: "Administration", href: "/admin/groups" }] : []),
];

function isActive(href: string) {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<div class="flex h-full flex-col gap-1 p-4">
  <div class="text-foreground mb-2 px-2 text-sm font-semibold">HireTrack</div>
  {
    navItems.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? "page" : undefined}
        class:list={[
          "rounded-md px-2 py-2 text-sm font-medium transition-colors",
          isActive(item.href)
            ? "bg-accent text-accent-foreground"
            : "text-muted-foreground hover:bg-accent hover:text-accent-foreground",
        ]}
      >
        {item.label}
      </a>
    ))
  }
</div>
