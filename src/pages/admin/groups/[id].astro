---
import Layout from "@/layouts/Layout.astro";
import { SecurityGroupDetail } from "@/components/admin/SecurityGroupDetail";

const isAdmin = Astro.locals.operations.includes("group.manage");
const groupId = Astro.params.id ?? "";
---

<Layout title="Admin - Security Group">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto max-w-4xl">
      {
        isAdmin ? (
          <SecurityGroupDetail groupId={groupId} client:load />
        ) : (
          <p class="rounded-xl border border-white/10 bg-white/5 px-4 py-6 text-center text-blue-100/70">
            You are not authorized to view this page.
          </p>
        )
      }
    </div>
  </div>
</Layout>
