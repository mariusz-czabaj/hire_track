---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/AppShell.astro";
import Sidebar from "@/components/Sidebar.astro";
import { ThemeToggle } from "@/components/ThemeToggle";
import { UserMenu } from "@/components/UserMenu";
import { SidebarToggle } from "@/components/SidebarToggle";
import { MobileNav } from "@/components/MobileNav";
import { CandidateList } from "@/components/candidates/CandidateList";

const initialQuery = Astro.url.searchParams.get("q") ?? undefined;
---

<Layout title="Candidates">
  <AppShell containerWidth="standard">
    <Fragment slot="nav">
      <Sidebar />
    </Fragment>
    <Fragment slot="topbar-leading">
      <SidebarToggle collapsed={Astro.locals.sidebarCollapsed} client:load />
      <MobileNav client:load>
        <Sidebar />
      </MobileNav>
    </Fragment>
    <Fragment slot="topbar-actions">
      <ThemeToggle theme={Astro.locals.theme} client:load />
      {Astro.locals.user && <UserMenu email={Astro.locals.user.email ?? ""} client:load />}
    </Fragment>
    <Fragment slot="page-title">
      <h1 class="text-foreground text-3xl font-bold">Candidates</h1>
    </Fragment>
    <CandidateList initialQuery={initialQuery} client:load />
  </AppShell>
</Layout>
