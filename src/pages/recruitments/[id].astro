---
import Layout from "@/layouts/Layout.astro";
import { KanbanBoard } from "@/components/recruitments/KanbanBoard";

const { id } = Astro.params;
---

<Layout title="Recruitment board">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto max-w-6xl">
      <a href="/recruitments" class="mb-4 inline-block text-sm text-blue-100/60 hover:text-blue-100">
        &larr; Back to recruitments
      </a>
      <KanbanBoard recruitmentId={id} client:load />
    </div>
  </div>
</Layout>
