---
import Layout from "@/layouts/Layout.astro";
import { RecruitmentList } from "@/components/recruitments/RecruitmentList";

const initialStatus = Astro.url.searchParams.get("status") ?? undefined;
---

<Layout title="Recruitments">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto max-w-4xl">
      <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Recruitments
        </h1>
        <a
          href="/recruitments/new"
          class="shrink-0 rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          New recruitment
        </a>
      </div>
      <RecruitmentList initialStatus={initialStatus} client:load />
    </div>
  </div>
</Layout>
