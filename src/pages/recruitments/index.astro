---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/AppShell.astro";
import Sidebar from "@/components/Sidebar.astro";
import { ThemeToggle } from "@/components/ThemeToggle";
import { UserMenu } from "@/components/UserMenu";
import { SidebarToggle } from "@/components/SidebarToggle";
import { MobileNav } from "@/components/MobileNav";
import { RecruitmentList } from "@/components/recruitments/RecruitmentList";

const initialStatus = Astro.url.searchParams.get("status") ?? "live";
---

<Layout title="Recruitments">
  <AppShell containerWidth="standard">
    <Fragment slot="nav">
      <Sidebar />
    </Fragment>
    <Fragment slot="topbar-leading">
      <SidebarToggle collapsed={Astro.locals.sidebarCollapsed} client:load />
      <MobileNav client:load>
        <Sidebar />
      </MobileNav>
    </Fragment>
    <Fragment slot="topbar-actions">
      <ThemeToggle theme={Astro.locals.theme} client:load />
      {Astro.locals.user && <UserMenu email={Astro.locals.user.email ?? ""} client:load />}
    </Fragment>
    <Fragment slot="page-title">
      <h1 class="text-foreground font-serif text-4xl font-bold">Recruitments</h1>
    </Fragment>
    <Fragment slot="page-actions">
      <a
        href="/recruitments/new"
        class="bg-primary text-primary-foreground hover:bg-primary/90 shrink-0 rounded-lg px-4 py-2 text-sm font-medium transition-colors"
      >
        New recruitment
      </a>
    </Fragment>
    <RecruitmentList initialStatus={initialStatus} client:load />
  </AppShell>
</Layout>
