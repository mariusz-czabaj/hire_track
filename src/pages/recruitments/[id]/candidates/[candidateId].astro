---
import Layout from "@/layouts/Layout.astro";
import AppShell from "@/components/AppShell.astro";
import Sidebar from "@/components/Sidebar.astro";
import { ThemeToggle } from "@/components/ThemeToggle";
import { UserMenu } from "@/components/UserMenu";
import { SidebarToggle } from "@/components/SidebarToggle";
import { MobileNav } from "@/components/MobileNav";
import { CandidateDetail } from "@/components/recruitments/CandidateDetail";

const { id, candidateId } = Astro.params;
---

<Layout title="Candidate detail">
  <AppShell containerWidth="standard">
    <Fragment slot="nav">
      <Sidebar />
    </Fragment>
    <Fragment slot="topbar-leading">
      <SidebarToggle collapsed={Astro.locals.sidebarCollapsed} client:load />
      <MobileNav client:load>
        <Sidebar />
      </MobileNav>
    </Fragment>
    <Fragment slot="topbar-actions">
      <ThemeToggle theme={Astro.locals.theme} client:load />
      {Astro.locals.user && <UserMenu email={Astro.locals.user.email ?? ""} client:load />}
    </Fragment>
    <a href={`/recruitments/${id}`} class="text-muted-foreground hover:text-foreground mb-4 inline-block text-sm">
      &larr; Back to board
    </a>
    <CandidateDetail recruitmentId={id} candidateRecruitmentId={candidateId} client:load />
  </AppShell>
</Layout>
