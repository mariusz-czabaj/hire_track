---
import Layout from "@/layouts/Layout.astro";
import { CandidateDetail } from "@/components/recruitments/CandidateDetail";

const { id, candidateId } = Astro.params;
---

<Layout title="Candidate detail">
  <div class="bg-cosmic min-h-screen p-4 text-white sm:p-8">
    <div class="mx-auto max-w-3xl">
      <a href={`/recruitments/${id}`} class="mb-4 inline-block text-sm text-blue-100/60 hover:text-blue-100">
        &larr; Back to board
      </a>
      <CandidateDetail recruitmentId={id} candidateRecruitmentId={candidateId} client:load />
    </div>
  </div>
</Layout>
